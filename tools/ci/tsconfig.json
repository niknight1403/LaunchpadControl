{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "./rn-shims.d.ts",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../scripts/**/*.ts",
    "../../App.tsx"
  ]
}
