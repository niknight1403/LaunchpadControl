{
  "name": "launchpadcontrol",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchpadControl (AuraGrid) \u2014 low-latency live performance & DJ system for Android",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "test:logic": "esbuild scripts/selftest.ts --bundle --platform=node --format=cjs --outfile=.tmp/selftest.cjs && node .tmp/selftest.cjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-haptics": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
